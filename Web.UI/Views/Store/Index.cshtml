@model IEnumerable<StoreProductListDto>
@{
    ViewData["Title"] = "Mağaza Ürünleri";
}

<h2>Mağaza Ürünleri</h2>
<a asp-action="createProduct" asp-controller="store" class="btn btn-primary btn-sm">
    Yeni Ürün Ekle
</a>
<hr />
<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th>Stok Kodu (SKU)</th>
            <th>Ad</th>
            <th>Fiyat</th>
            <th>Stok Durumu</th>
            <th>Marka</th>
            <th>Kategori</th>
            <th>Güncellenme Tarihi</th>
            <th>Durumu</th>
            <th class="text-end">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SKU</td>
                <td>@item.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@(item.Stock > 0 ? item.Stock : "Stok yok")</td>
                <td>@item.BrandName</td>
                <td>@item.CategoryName</td>
                <td>@item.UpdatedAt</td>
                <td>@(item.Active ? "Satışta" : "Satışta değil")</td>
                <td class="text-end">
                    <form method="post" asp-action="deleteproduct" asp-controller="store" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Bu ürünü silmek istediğinize emin misiniz?')">
                        <div class="btn-group" role="group">
                            <a asp-action="productdetail" asp-controller="store" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detay</a>
                            <a asp-action="editproduct" asp-controller="store" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Düzenle</a>
                            <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                        </div>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
