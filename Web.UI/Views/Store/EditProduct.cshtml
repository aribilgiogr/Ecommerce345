@model UpdateProductDto
@{
    ViewData["Title"] = "Ürün Güncele";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card text-bg-light shadow">
            <div class="card-header">
                <h5 class="card-title">@ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                <form asp-action="editproduct" asp-controller="store" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @Html.HiddenFor(m => m.Id)

                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" />
                        <label asp-for="Name" class="form-label"></label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <textarea asp-for="Description" class="form-control"></textarea>
                        <label asp-for="Description" class="form-label"></label>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Price" class="form-control" />
                        <label asp-for="Price" class="form-label"></label>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Stock" class="form-control" />
                        <label asp-for="Stock" class="form-label"></label>
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="SKU" class="form-control" />
                        <label asp-for="SKU" class="form-label"></label>
                        <span asp-validation-for="SKU" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                            <option value="" disabled selected>Marka Seçin</option>
                        </select>
                        <label asp-for="BrandId" class="form-label"></label>
                        <span asp-validation-for="BrandId" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                            <option value="" disabled selected>Kategori Seçin</option>
                        </select>
                        <label asp-for="CategoryId" class="form-label"></label>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3 form-switch">
                        <input asp-for="Active" class="form-check-input" role="switch" />
                        <label asp-for="Active" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                </form>
            </div>
        </div>
    </div>
</div>