@{
    Layout = "_Layout";
}
<div class="row">
    <div class="col-md-4 mx-auto">
        <div class="card bg-white shadow rounded-0 my-5">
            <div class="card-header bg-info bg-gradient bg-opacity-50">
                <h4 class="text-center">@ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                    @RenderBody()
                </form>
            </div>
        </div>
    </div>
</div>