@inject UserManager<AppUser> UserManager
@{
    AppUser? user = await UserManager.GetUserAsync(User);
    ViewData["Title"] = user!.UserType == UserType.Customer ? "Müşteri Profili" : "Mağaza Profili";
}

<h1>
    Merhaba,
    @if (user.UserType == UserType.Customer)
    {
        <text>Sayın @user.CustomerProfile!.FirstName @user.CustomerProfile.LastName</text>
    }
    else if (user.UserType == UserType.StoreOwner)
    {
        <text>@user.StoreProfile!.StoreName Mağazası Yöneticisi</text>
    }
</h1>