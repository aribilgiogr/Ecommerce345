@model RegisterCustomerDto
@{
    ViewData["Title"] = "Müşteri Kayıt Formu";
    Layout = "_AuthFormLayout";
}
<div class="form-floating mb-3">
    <input asp-for="FirstName" class="form-control" />
    <label asp-for="FirstName"></label>
    <span class="text-danger" asp-validation-for="FirstName"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="LastName" class="form-control" />
    <label asp-for="LastName"></label>
    <span class="text-danger" asp-validation-for="LastName"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="Email" class="form-control" />
    <label asp-for="Email"></label>
    <span class="text-danger" asp-validation-for="Email"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="Password" class="form-control" />
    <label asp-for="Password"></label>
    <span class="text-danger" asp-validation-for="Password"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="ConfirmPassword" class="form-control" />
    <label asp-for="ConfirmPassword"></label>
    <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
</div>

<button type="submit" class="btn btn-primary w-100 mb-5">Kayıt Ol</button>
<hr />
<p class="text-center text-muted small">
    Zaten bir hesabınız var mı?
    <a asp-controller="Account" asp-action="Login" class="link-success text-decoration-none fw-bold">Giriş Yapın!</a>
</p>