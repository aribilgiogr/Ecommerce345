@model LoginDto
@{
    ViewData["Title"] = "Giriş Formu";
    Layout = "_AuthFormLayout";
}

<div class="form-floating mb-3">
    <input asp-for="Email" class="form-control" />
    <label asp-for="Email"></label>
    <span class="text-danger" asp-validation-for="Email"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="Password" class="form-control" />
    <label asp-for="Password"></label>
    <span class="text-danger" asp-validation-for="Password"></span>
</div>

<div class="form-check mb-3">
    <input asp-for="RememberMe" class="form-check-input" />
    <label asp-for="RememberMe" class="form-check-label"></label>
</div>

<button type="submit" class="btn btn-primary w-100 mb-5">Giriş Yap</button>

<p class="text-center text-muted small">
    Kayıtlı değil misiniz? <a asp-controller="Account" asp-action="RegisterCustomer" class="link-success text-decoration-none fw-bold">Müşteri</a> olabilir veya <a asp-controller="Account" asp-action="RegisterStore" class="link-success text-decoration-none fw-bold">mağaza</a> kurabilirsiniz.
</p>