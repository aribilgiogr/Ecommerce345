@using Core.Concretes.DTOs
@model LoginDto
@{
    ViewData["Title"] = "Giriş Formu";
}

<div style="min-height: 100vh; background: linear-gradient(135deg, #F0F9FB 0%, #FFF5E6 100%); 
            display: flex; align-items: center; justify-content: center; padding: 2rem;">
    <div style="width: 100%; max-width: 400px;">
        <!-- Başlık -->
        <div style="text-align: center; margin-bottom: 2rem;">
            <h1 style="color: #45B8B0; font-size: 2rem; margin: 0; font-weight: 700;">
                Giriş Yap
            </h1>
            <p style="color: #999; margin: 0.5rem 0 0 0; font-size: 0.95rem;">
                Hesabınıza erişmek için giriş yapın
            </p>
        </div>

        <!-- Form Kartı -->
        <div style="background: white; border-radius: 16px; padding: 2.5rem; 
                    box-shadow: 0 20px 60px rgba(78, 205, 196, 0.15);
                    border-top: 5px solid #4ECDC4;">
            
            <form asp-action="login" asp-controller="account" method="post">
                @Html.AntiForgeryToken()
                
                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" style="background: #FFE5E5; color: #C33; 
                                                               padding: 0.8rem; border-radius: 8px; 
                                                               margin-bottom: 1.5rem; font-size: 0.9rem;
                                                               border-left: 4px solid #C33; display: none;" 
                     id="validationSummary"></div>
                <script>
                    if (document.querySelector('.field-validation-error')) {
                        document.getElementById('validationSummary').style.display = 'block';
                    }
                </script>

                <!-- Email Alanı -->
                <div style="margin-bottom: 1.5rem;">
                    <label asp-for="Email" style="display: block; color: #45B8B0; font-weight: 600; 
                                                   margin-bottom: 0.5rem; font-size: 0.95rem;">
                        📧 Eposta Adresi
                    </label>
                    <input class="form-control" asp-for="Email" type="email" 
                           placeholder="ornek@email.com"
                           style="width: 100%; padding: 0.75rem; border: 2px solid #E8F4F8; 
                                  border-radius: 8px; font-size: 0.95rem; transition: all 0.3s;
                                  font-family: inherit;"
                           onfocus="this.style.borderColor='#4ECDC4'; this.style.boxShadow='0 0 0 3px rgba(78,205,196,0.1)'"
                           onblur="this.style.borderColor='#E8F4F8'; this.style.boxShadow='none'" />
                    <span asp-validation-for="Email" style="color: #E74C3C; font-size: 0.85rem; 
                                                            display: block; margin-top: 0.4rem;"></span>
                </div>

                <!-- Parola Alanı -->
                <div style="margin-bottom: 1.5rem;">
                    <label asp-for="Password" style="display: block; color: #45B8B0; font-weight: 600; 
                                                     margin-bottom: 0.5rem; font-size: 0.95rem;">
                        🔐 Parola
                    </label>
                    <input class="form-control" asp-for="Password" 
                           placeholder="Parolanızı giriniz"
                           style="width: 100%; padding: 0.75rem; border: 2px solid #E8F4F8; 
                                  border-radius: 8px; font-size: 0.95rem; transition: all 0.3s;
                                  font-family: inherit;"
                           onfocus="this.style.borderColor='#4ECDC4'; this.style.boxShadow='0 0 0 3px rgba(78,205,196,0.1)'"
                           onblur="this.style.borderColor='#E8F4F8'; this.style.boxShadow='none'" />
                    <span asp-validation-for="Password" style="color: #E74C3C; font-size: 0.85rem; 
                                                               display: block; margin-top: 0.4rem;"></span>
                </div>

                <!-- Beni Hatırla -->
                <div style="margin-bottom: 2rem; display: flex; align-items: center;">
                    <input class="form-check-input" asp-for="RememberMe" type="checkbox"
                           style="width: 18px; height: 18px; cursor: pointer; accent-color: #4ECDC4;" />
                    <label asp-for="RememberMe" style="margin-left: 0.7rem; color: #666; 
                                                       cursor: pointer; margin: 0 0 0 0.7rem; font-size: 0.95rem;">
                        Beni hatırla
                    </label>
                </div>

                <!-- Giriş Butonu -->
                <button type="submit" style="width: 100%; padding: 0.9rem; 
                                            background: linear-gradient(135deg, #4ECDC4 0%, #45B8B0 100%);
                                            color: white; border: none; border-radius: 8px;
                                            font-weight: 600; font-size: 1rem; cursor: pointer;
                                            box-shadow: 0 8px 25px rgba(78, 205, 196, 0.3);
                                            transition: all 0.3s;"
                        onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 12px 35px rgba(78, 205, 196, 0.4)'"
                        onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 8px 25px rgba(78, 205, 196, 0.3)'">
                    Giriş Yap
                </button>
            </form>

            <!-- Kayıt Linki -->
            <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.5rem; 
                        border-top: 1px solid #F0F0F0;">
                <p style="color: #999; margin: 0; font-size: 0.9rem;">
                    Hesabınız yok mu? 
                    <a href="/Account/RegisterCustomer" style="color: #4ECDC4; text-decoration: none; 
                                                              font-weight: 600; transition: color 0.3s;"
                       onmouseover="this.style.color='#45B8B0'" 
                       onmouseout="this.style.color='#4ECDC4'">
                        Müşteri Olarak Kayıt Olun
                    </a>
                </p>
                <p style="color: #999; margin: 0.5rem 0 0 0; font-size: 0.9rem;">
                    Mağaza sahibi misiniz? 
                    <a href="/Account/RegisterStore" style="color: #FFA500; text-decoration: none; 
                                                           font-weight: 600; transition: color 0.3s;"
                       onmouseover="this.style.color='#FF8C00'" 
                       onmouseout="this.style.color='#FFA500'">
                        Mağaza Olarak Kayıt Olun
                    </a>
                </p>
            </div>
        </div>

        <!-- Alt Bilgi -->
        <p style="text-align: center; color: #AAA; font-size: 0.85rem; margin-top: 2rem;">
            © 2024 E-Ticaret Platformu. Tüm hakları saklıdır.
        </p>
    </div>
</div>
