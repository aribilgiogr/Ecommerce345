@model RegisterStoreDto
@{
    ViewData["Title"] = "Mağaza Kayıt Formu";
    Layout = "_AuthFormLayout";
}

<div class="form-floating mb-3">
    <input asp-for="StoreName" class="form-control" />
    <label asp-for="StoreName"></label>
    <span class="text-danger" asp-validation-for="StoreName"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="TaxOffice" class="form-control" />
    <label asp-for="TaxOffice"></label>
    <span class="text-danger" asp-validation-for="TaxOffice"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="TaxNumber" class="form-control" />
    <label asp-for="TaxNumber"></label>
    <span class="text-danger" asp-validation-for="TaxNumber"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="ContactEmail" class="form-control" />
    <label asp-for="ContactEmail"></label>
    <span class="text-danger" asp-validation-for="ContactEmail"></span>
</div>
<div class="form-floating mb-3">
    <input asp-for="ContactPhone" class="form-control" />
    <label asp-for="ContactPhone"></label>
    <span class="text-danger" asp-validation-for="ContactPhone"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="Email" class="form-control" />
    <label asp-for="Email"></label>
    <span class="text-danger" asp-validation-for="Email"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="Password" class="form-control" />
    <label asp-for="Password"></label>
    <span class="text-danger" asp-validation-for="Password"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="ConfirmPassword" class="form-control" />
    <label asp-for="ConfirmPassword"></label>
    <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
</div>

<button type="submit" class="btn btn-primary w-100 mb-5">Kayıt Ol</button>
<hr />
<p class="text-center text-muted small">
    Zaten bir hesabınız var mı?
    <a asp-controller="Account" asp-action="Login" class="link-success text-decoration-none fw-bold">Giriş Yapın!</a>
</p>
