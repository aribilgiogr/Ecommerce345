@using Core.Concretes.DTOs
@model RegisterStoreDto
@{
    ViewData["Title"] = "Mağaza Kayıt Formu";
}

<div style="min-height: 100vh; background: linear-gradient(135deg, #FFF5E6 0%, #F0F9FB 100%); 
            padding: 2rem;">
    <div class="container">
        <div style="max-width: 550px; margin: 0 auto;">
            <!-- Başlık -->
            <div style="text-align: center; margin-bottom: 2rem;">
                <h1 style="color: #D4A574; font-size: 2rem; margin: 0; font-weight: 700;">
                    🏪 Mağaza Kayıt
                </h1>
                <p style="color: #999; margin: 0.5rem 0 0 0; font-size: 0.95rem;">
                    Mağazanızı kayıt edin ve satışa başlayın
                </p>
            </div>

            <!-- Form Kartı -->
            <div style="background: white; border-radius: 16px; padding: 2.5rem; 
                        box-shadow: 0 20px 60px rgba(212, 165, 116, 0.1);
                        border-top: 5px solid #D4A574;">
                
                <form asp-action="registerStore" asp-controller="account" method="post">
                    @Html.AntiForgeryToken()
                    
                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" style="background: #FFE5E5; color: #C33; 
                                                                   padding: 0.8rem; border-radius: 8px; 
                                                                   margin-bottom: 1.5rem; font-size: 0.9rem;
                                                                   border-left: 4px solid #C33; display: none;"
                         id="validationSummary"></div>
                    <script>
                        if (document.querySelector('.field-validation-error')) {
                            document.getElementById('validationSummary').style.display = 'block';
                        }
                    </script>

                    <!-- Bölüm 1: Mağaza Bilgileri -->
                    <div style="margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid #F5F0E8;">
                        <h3 style="color: #D4A574; font-size: 1.1rem; margin: 0 0 1.2rem 0; font-weight: 600;">
                            📝 Mağaza Bilgileri
                        </h3>

                        <!-- Mağaza Adı -->
                        <div style="margin-bottom: 1.5rem;">
                            <label asp-for="StoreName" style="display: block; color: #D4A574; font-weight: 600; 
                                                              margin-bottom: 0.5rem; font-size: 0.9rem;">
                                Mağaza Adı
                            </label>
                            <input asp-for="StoreName" class="form-control" type="text"
                                   placeholder="Örn: Mağazanın Adı"
                                   style="width: 100%; padding: 0.75rem; border: 2px solid #F5E8DB; 
                                          border-radius: 8px; font-size: 0.9rem; transition: all 0.3s;
                                          font-family: inherit;"
                                   onfocus="this.style.borderColor='#D4A574'; this.style.boxShadow='0 0 0 3px rgba(212,165,116,0.1)'"
                                   onblur="this.style.borderColor='#F5E8DB'; this.style.boxShadow='none'" />
                            <span asp-validation-for="StoreName" style="color: #E74C3C; font-size: 0.8rem; 
                                                                        display: block; margin-top: 0.3rem;"></span>
                        </div>

                        <!-- Vergi Dairesi ve Vergi Numarası -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                            <div>
                                <label asp-for="TaxOffice" style="display: block; color: #D4A574; font-weight: 600; 
                                                                  margin-bottom: 0.5rem; font-size: 0.9rem;">
                                    Vergi Dairesi
                                </label>
                                <input asp-for="TaxOffice" class="form-control" type="text"
                                       placeholder="Vergi Dairesi"
                                       style="width: 100%; padding: 0.75rem; border: 2px solid #F5E8DB; 
                                              border-radius: 8px; font-size: 0.9rem; transition: all 0.3s;
                                              font-family: inherit; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#D4A574'; this.style.boxShadow='0 0 0 3px rgba(212,165,116,0.1)'"
                                       onblur="this.style.borderColor='#F5E8DB'; this.style.boxShadow='none'" />
                                <span asp-validation-for="TaxOffice" style="color: #E74C3C; font-size: 0.8rem; 
                                                                            display: block; margin-top: 0.3rem;"></span>
                            </div>
                            <div>
                                <label asp-for="TaxNumber" style="display: block; color: #D4A574; font-weight: 600; 
                                                                  margin-bottom: 0.5rem; font-size: 0.9rem;">
                                    Vergi Numarası
                                </label>
                                <input asp-for="TaxNumber" class="form-control" type="text"
                                       placeholder="Vergi Numarası"
                                       style="width: 100%; padding: 0.75rem; border: 2px solid #F5E8DB; 
                                              border-radius: 8px; font-size: 0.9rem; transition: all 0.3s;
                                              font-family: inherit; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#D4A574'; this.style.boxShadow='0 0 0 3px rgba(212,165,116,0.1)'"
                                       onblur="this.style.borderColor='#F5E8DB'; this.style.boxShadow='none'" />
                                <span asp-validation-for="TaxNumber" style="color: #E74C3C; font-size: 0.8rem; 
                                                                            display: block; margin-top: 0.3rem;"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Bölüm 2: İletişim Bilgileri -->
                    <div style="margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid #F5F0E8;">
                        <h3 style="color: #D4A574; font-size: 1.1rem; margin: 0 0 1.2rem 0; font-weight: 600;">
                            📞 İletişim Bilgileri
                        </h3>

                        <!-- Telefon ve Email -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                            <div>
                                <label asp-for="ContactPhone" style="display: block; color: #D4A574; font-weight: 600; 
                                                                    margin-bottom: 0.5rem; font-size: 0.9rem;">
                                    Telefon
                                </label>
                                <input asp-for="ContactPhone" class="form-control" type="tel"
                                       placeholder="0212 XXX XXXX"
                                       style="width: 100%; padding: 0.75rem; border: 2px solid #F5E8DB; 
                                              border-radius: 8px; font-size: 0.9rem; transition: all 0.3s;
                                              font-family: inherit; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#D4A574'; this.style.boxShadow='0 0 0 3px rgba(212,165,116,0.1)'"
                                       onblur="this.style.borderColor='#F5E8DB'; this.style.boxShadow='none'" />
                                <span asp-validation-for="ContactPhone" style="color: #E74C3C; font-size: 0.8rem; 
                                                                               display: block; margin-top: 0.3rem;"></span>
                            </div>
                            <div>
                                <label asp-for="ContactEmail" style="display: block; color: #D4A574; font-weight: 600; 
                                                                    margin-bottom: 0.5rem; font-size: 0.9rem;">
                                    İletişim Eposta
                                </label>
                                <input asp-for="ContactEmail" class="form-control" type="email"
                                       placeholder="iletisim@magaza.com"
                                       style="width: 100%; padding: 0.75rem; border: 2px solid #F5E8DB; 
                                              border-radius: 8px; font-size: 0.9rem; transition: all 0.3s;
                                              font-family: inherit; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#D4A574'; this.style.boxShadow='0 0 0 3px rgba(212,165,116,0.1)'"
                                       onblur="this.style.borderColor='#F5E8DB'; this.style.boxShadow='none'" />
                                <span asp-validation-for="ContactEmail" style="color: #E74C3C; font-size: 0.8rem; 
                                                                               display: block; margin-top: 0.3rem;"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Bölüm 3: Giriş Bilgileri -->
                    <div style="margin-bottom: 2rem;">
                        <h3 style="color: #D4A574; font-size: 1.1rem; margin: 0 0 1.2rem 0; font-weight: 600;">
                            🔐 Giriş Bilgileri
                        </h3>

                        <!-- Eposta -->
                        <div style="margin-bottom: 1.5rem;">
                            <label asp-for="Email" style="display: block; color: #D4A574; font-weight: 600; 
                                                          margin-bottom: 0.5rem; font-size: 0.9rem;">
                                Eposta Adresi
                            </label>
                            <input asp-for="Email" class="form-control" type="email"
                                   placeholder="ornek@magaza.com"
                                   style="width: 100%; padding: 0.75rem; border: 2px solid #F5E8DB; 
                                          border-radius: 8px; font-size: 0.9rem; transition: all 0.3s;
                                          font-family: inherit;"
                                   onfocus="this.style.borderColor='#D4A574'; this.style.boxShadow='0 0 0 3px rgba(212,165,116,0.1)'"
                                   onblur="this.style.borderColor='#F5E8DB'; this.style.boxShadow='none'" />
                            <span asp-validation-for="Email" style="color: #E74C3C; font-size: 0.8rem; 
                                                                    display: block; margin-top: 0.3rem;"></span>
                        </div>

                        <!-- Parola ve Parola Onayla -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                            <div>
                                <label asp-for="Password" style="display: block; color: #D4A574; font-weight: 600; 
                                                                margin-bottom: 0.5rem; font-size: 0.9rem;">
                                    Parola
                                </label>
                                <input asp-for="Password" class="form-control" type="password"
                                       placeholder="En az 6 karakter"
                                       style="width: 100%; padding: 0.75rem; border: 2px solid #F5E8DB; 
                                              border-radius: 8px; font-size: 0.9rem; transition: all 0.3s;
                                              font-family: inherit; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#D4A574'; this.style.boxShadow='0 0 0 3px rgba(212,165,116,0.1)'"
                                       onblur="this.style.borderColor='#F5E8DB'; this.style.boxShadow='none'" />
                                <span asp-validation-for="Password" style="color: #E74C3C; font-size: 0.8rem; 
                                                                           display: block; margin-top: 0.3rem;"></span>
                            </div>
                            <div>
                                <label asp-for="ConfirmPassword" style="display: block; color: #D4A574; font-weight: 600; 
                                                                       margin-bottom: 0.5rem; font-size: 0.9rem;">
                                    Parola Onayla
                                </label>
                                <input asp-for="ConfirmPassword" class="form-control" type="password"
                                       placeholder="Parolayı tekrar giriniz"
                                       style="width: 100%; padding: 0.75rem; border: 2px solid #F5E8DB; 
                                              border-radius: 8px; font-size: 0.9rem; transition: all 0.3s;
                                              font-family: inherit; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#D4A574'; this.style.boxShadow='0 0 0 3px rgba(212,165,116,0.1)'"
                                       onblur="this.style.borderColor='#F5E8DB'; this.style.boxShadow='none'" />
                                <span asp-validation-for="ConfirmPassword" style="color: #E74C3C; font-size: 0.8rem; 
                                                                                  display: block; margin-top: 0.3rem;"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Kayıt Butonu -->
                    <button type="submit" style="width: 100%; padding: 0.9rem; 
                                                background: linear-gradient(135deg, #D4A574 0%, #C9956F 100%);
                                                color: white; border: none; border-radius: 8px;
                                                font-weight: 600; font-size: 1rem; cursor: pointer;
                                                box-shadow: 0 8px 25px rgba(212, 165, 116, 0.3);
                                                transition: all 0.3s;"
                            onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 12px 35px rgba(212, 165, 116, 0.4)'"
                            onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 8px 25px rgba(212, 165, 116, 0.3)'">
                        Kayıt Ol
                    </button>
                </form>

                <!-- Giriş Linki -->
                <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.5rem; 
                            border-top: 1px solid #F5F0E8;">
                    <p style="color: #999; margin: 0; font-size: 0.9rem;">
                        Zaten hesabınız var mı? 
                        <a href="/Account/Login" style="color: #D4A574; text-decoration: none; 
                                                       font-weight: 600; transition: color 0.3s;"
                           onmouseover="this.style.color='#C9956F'" 
                           onmouseout="this.style.color='#D4A574'">
                            Giriş Yapın
                        </a>
                    </p>
                </div>
            </div>

            <!-- Alt Bilgi -->
            <p style="text-align: center; color: #AAA; font-size: 0.8rem; margin-top: 2rem;">
                Kayıt olarak, <a href="#" style="color: #D4A574; text-decoration: none;">Şartlar ve Koşullar</a>'ı kabul etmiş olursunuz.
            </p>
        </div>
    </div>
</div>
