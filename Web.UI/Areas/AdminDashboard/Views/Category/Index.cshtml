@model IEnumerable<CategoryListDto>
@{
    ViewData["Title"] = "Kategoriler";
}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Kategori Yönetimi</h1>
    <a asp-action="create" asp-controller="category" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Yeni Kategori Ekle
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h6 class="m-0 fw-bold text-primary">Kategori Listesi</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light">
                    <tr>
                        <th>Kategori Adı</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var category in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-medium">@category.Name</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="edit" asp-controller="category" asp-route-id="@category.Id" class="btn btn-outline-primary btn-sm">Düzenle</a>
                                        <form method="post" asp-action="delete" asp-controller="category" asp-route-id="@category.Id" class="d-inline" onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?')">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                Henüz hiç kategori eklenmemiş!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
